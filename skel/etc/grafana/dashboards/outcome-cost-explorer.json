    {
      "datasource": {
        "type": "mysql",
        "uid": "teamster-mysql"
      },
      "description": "Fully rolled-up cost: this outcome's own spend plus every workunit, child outcome, and rework underneath it.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 2
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "teamster-mysql"
          },
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT ROUND(SUM(cost_usd), 2) AS value\nFROM outcome_true_cost_rollup tcr\nWHERE tcr.bucket_hour BETWEEN $__timeFrom() AND $__timeTo()\n  AND (('${filter_value:raw}' = 'All' OR '${filter_value:raw}' = '\\$__all' OR '${filter_value:raw}' = '') OR EXISTS (SELECT 1 FROM entity_tags ef JOIN tags tf ON tf.id = ef.tag_id WHERE ef.entity_type = 'outcome' AND ef.entity_id = tcr.outcome_id AND tf.tag_key = '${filter_key:raw}' AND tf.tag_value = '${filter_value:raw}'))"
        }
      ],
      "title": "Outcome Cost",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "mysql",
        "uid": "teamster-mysql"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 2
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "teamster-mysql"
          },
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT COUNT(DISTINCT tcr.outcome_id) AS value\nFROM outcome_true_cost_rollup tcr\nWHERE tcr.bucket_hour BETWEEN $__timeFrom() AND $__timeTo()\n  AND (('${filter_value:raw}' = 'All' OR '${filter_value:raw}' = '\\$__all' OR '${filter_value:raw}' = '') OR EXISTS (SELECT 1 FROM entity_tags ef JOIN tags tf ON tf.id = ef.tag_id WHERE ef.entity_type = 'outcome' AND ef.entity_id = tcr.outcome_id AND tf.tag_key = '${filter_key:raw}' AND tf.tag_value = '${filter_value:raw}'))"
        }
      ],
      "title": "Outcomes with Cost",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "mysql",
        "uid": "teamster-mysql"
      },
      "description": "Total rolled-up cost per outcome, binned by the Aggregation selector. Each series is one outcome's full cost — direct, workunits, children, and rework all summed together.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "barAlignment": 0,
            "lineWidth": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "teamster-mysql"
          },
          "format": "time_series",
          "refId": "A",
          "rawSql": "SELECT\n  $__timeGroupAlias(tcr.bucket_hour, $agg),\n  COALESCE(o.title, tcr.outcome_id) AS metric,\n  ROUND(SUM(tcr.cost_usd), 4) AS value\nFROM outcome_true_cost_rollup tcr\nLEFT JOIN outcomes o ON o.id = tcr.outcome_id\nWHERE tcr.bucket_hour BETWEEN $__timeFrom() AND $__timeTo()\n  AND (('${filter_value:raw}' = 'All' OR '${filter_value:raw}' = '\\$__all' OR '${filter_value:raw}' = '') OR EXISTS (SELECT 1 FROM entity_tags ef JOIN tags tf ON tf.id = ef.tag_id WHERE ef.entity_type = 'outcome' AND ef.entity_id = tcr.outcome_id AND tf.tag_key = '${filter_key:raw}' AND tf.tag_value = '${filter_value:raw}'))\nGROUP BY 1, tcr.outcome_id, o.title\nORDER BY 1"
        }
      ],
      "title": "Cost by Outcome",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "mysql",
        "uid": "teamster-mysql"
      },
      "description": "Every outcome with cost in the selected period, fully rolled up.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 8,
      "pluginVersion": "12.1.1",
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "total_cost"
          }
        ],
        "footer": {
          "enablePagination": false,
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "total_cost"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "teamster-mysql"
          },
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT\n  COALESCE(o.title, tcr.outcome_id) AS outcome,\n  COALESCE(o.status, '') AS status,\n  (SELECT COUNT(*) FROM workunits w WHERE w.outcome_id = tcr.outcome_id) AS workunits,\n  ROUND(SUM(tcr.cost_usd), 2) AS total_cost\nFROM outcome_true_cost_rollup tcr\nLEFT JOIN outcomes o ON o.id = tcr.outcome_id\nWHERE tcr.bucket_hour BETWEEN $__timeFrom() AND $__timeTo()\n  AND (('${filter_value:raw}' = 'All' OR '${filter_value:raw}' = '\\$__all' OR '${filter_value:raw}' = '') OR EXISTS (SELECT 1 FROM entity_tags ef JOIN tags tf ON tf.id = ef.tag_id WHERE ef.entity_type = 'outcome' AND ef.entity_id = tcr.outcome_id AND tf.tag_key = '${filter_key:raw}' AND tf.tag_value = '${filter_value:raw}'))\nGROUP BY tcr.outcome_id, o.title, o.status\nORDER BY total_cost DESC\nLIMIT 100"
        }
      ],
      "title": "Outcome Summary",
      "type": "table"
    }
  ],
