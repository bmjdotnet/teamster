        "name": "filter_key",
        "query": "SELECT DISTINCT t.tag_key FROM tags t JOIN entity_tags et ON et.tag_id = t.id WHERE (t.category = 'context' OR t.tag_key IN ('work-type','phase','priority')) AND t.tag_key NOT LIKE 'git.%' ORDER BY t.tag_key",
