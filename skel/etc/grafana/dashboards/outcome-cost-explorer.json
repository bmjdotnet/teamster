        },
        "includeAll": true,
        "label": "Filter Value",
        "name": "filter_value",
        "query": "SELECT DISTINCT t.tag_value FROM tags t JOIN entity_tags et ON et.tag_id = t.id WHERE t.tag_key = '${filter_key}' AND t.tag_value != '' ORDER BY t.tag_value",
