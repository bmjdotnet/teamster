[Unit]
Description=Teamster WMS review-sweep (nightly, config-gated)
After=network.target teamster-hookd.service

[Service]
Type=oneshot
User=__USER__
ExecStart=/bin/bash -c '__BASEDIR__/bin/teamster wms review-sweep 2>&1 | tee -a __BASEDIR__/var/review-sweep.log'
Environment=TEAMSTER_DATA_DIR=__BASEDIR__/var
Environment=TEAMSTER_SESSION_ID=wms-review-sweep
